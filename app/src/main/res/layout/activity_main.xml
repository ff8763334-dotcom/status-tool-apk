<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/btnTabDeco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="🎨 تزيين الحالة" />

        <Button
            android:id="@+id/btnTabSaver"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💾 حفظ الحالات" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- ===== قسم التزيين ===== -->
            <LinearLayout
                android:id="@+id/sectionDeco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnPickImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📷 اختيار صورة" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="380dp"
                    android:layout_marginTop="10dp"
                    android:background="#000000">

                    <com.statustool.app.DrawingView
                        android:id="@+id/drawingView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <EditText
                    android:id="@+id/editText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="اكتب نصاً ثم اضغط إضافة"
                    android:textColorHint="@color/muted"
                    android:textColor="@color/text"
                    android:layout_marginTop="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <Button android:id="@+id/colorWhite" android:layout_width="40dp" android:layout_height="40dp" android:background="#FFFFFF" android:layout_marginEnd="6dp" android:text="" />
                    <Button android:id="@+id/colorBlack" android:layout_width="40dp" android:layout_height="40dp" android:background="#000000" android:layout_marginEnd="6dp" android:text="" />
                    <Button android:id="@+id/colorRed" android:layout_width="40dp" android:layout_height="40dp" android:background="#EF4444" android:layout_marginEnd="6dp" android:text="" />
                    <Button android:id="@+id/colorYellow" android:layout_width="40dp" android:layout_height="40dp" android:background="#FACC15" android:layout_marginEnd="6dp" android:text="" />
                    <Button android:id="@+id/colorGreen" android:layout_width="40dp" android:layout_height="40dp" android:background="#22C55E" android:text="" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sizeSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="80"
                    android:progress="36"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnAddText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="➕ إضافة النص إلى الصورة"
                    android:layout_marginTop="4dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:id="@+id/emojiBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Spinner
                    android:id="@+id/frameSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnUndo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="↩️ تراجع" />

                    <Button
                        android:id="@+id/btnExport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⬇️ حفظ الصورة" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== قسم حفظ الحالات ===== -->
            <LinearLayout
                android:id="@+id/sectionSaver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:text="اضغط الزر أدناه واختر مجلد:\nAndroid/media/com.whatsapp/WhatsApp/Media/.Statuses" />

                <Button
                    android:id="@+id/btnPickFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="📂 اختيار مجلد الحالات" />

                <TextView
                    android:id="@+id/emptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="لم يتم اختيار مجلد بعد" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/gridRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</LinearLayout>
